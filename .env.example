# Eventbrite API
# Use the Private token as the API key (for Bearer authentication)
EVENTBRITE_API_KEY=your_eventbrite_private_token_here
EVENTBRITE_CLIENT_SECRET=your_eventbrite_client_secret_here
EVENTBRITE_PUBLIC_TOKEN=your_eventbrite_public_token_here

# Apify API (for enhanced web scraping)
APIFY_API_TOKEN=your_apify_api_token_here

# OpenAI API (optional - for AI-powered email generation)
OPENAI_API_KEY=your_openai_api_key_here

# Email settings (optional - for future sending capability)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
