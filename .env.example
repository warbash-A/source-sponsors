# Eventbrite API
EVENTBRITE_API_KEY=your_eventbrite_api_key_here

# Meetup API (OAuth2 access token)
# Get from: https://www.meetup.com/api/oauth/list/
MEETUP_ACCESS_TOKEN=your_meetup_access_token_here

# Apify API (for enhanced web scraping)
APIFY_API_TOKEN=your_apify_api_token_here

# OpenAI API (optional - for AI-powered email generation)
OPENAI_API_KEY=your_openai_api_key_here

# Email settings (optional - for future sending capability)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
